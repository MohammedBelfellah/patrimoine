DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,geopatrimoinehub.com,www.geopatrimoinehub.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://geopatrimoinehub.com,https://www.geopatrimoinehub.com
APP_BASE_URL=https://geopatrimoinehub.com

# Optional: use one connection string instead of POSTGRES_* vars (recommended for Supabase)
# Prefer direct host for local reliability: db.<project-ref>.supabase.co
# IMPORTANT: URL-encode special chars in password (@ => %40, $ => %24, ! => %21)
# Example: postgresql://postgres:my%40pass%24word%21@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

POSTGRES_DB=patrimoine
POSTGRES_USER=patrimoine
POSTGRES_PASSWORD=patrimoine
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Email configuration
# Railway can block/timeout SMTP. Prefer Brevo HTTPS API in production.
EMAIL_BACKEND=core.email_backends.BrevoApiEmailBackend
BREVO_API_KEY=
BREVO_API_TIMEOUT=15

# Optional SMTP fallback for local/dev only
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_TIMEOUT=15
EMAIL_SEND_ASYNC=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Geo Patrimoine Hub <noreply@geopatrimoinehub.com>"
SERVER_EMAIL=noreply@geopatrimoinehub.com

# Public chatbot (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Public feedback (Google Form). Use false / 0 / off to hide the navbar button.
# FEEDBACK_FORM_URL=https://forms.gle/LqXUASKzBPhthe2w6
